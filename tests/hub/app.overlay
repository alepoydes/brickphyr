#include <zephyr/dt-bindings/input/input-event-codes.h>
/ {
	test_pwm: test-pwm {
		compatible = "zephyr,fake-pwm";
		#pwm-cells = <2>;
		frequency = <96000000>;
	};
};
adc1: &adc0 {
	ref-internal-mv = <3300>;
	nchannels = <15>;
};
#include "../../boards/lego/spike_prime_f4/buttons.dtsi"
&spi0 {
	test_leds: leds@0 {
		compatible = "ti,tlc5955";
		reg = <0>;
		spi-max-frequency = <24000000>;
		latch-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		pwms = <&test_pwm 0 104>;
		initial-full-channels = <14>;
		status { channels = <5 4 3>; };
	};
};
