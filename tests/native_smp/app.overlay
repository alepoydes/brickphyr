/* SPDX-License-Identifier: Apache-2.0 */
/* A small synthetic store exercises capacity failures without a long transfer. */
/ {
	hub_speaker: speaker {
		compatible = "vnd,sound-output";
		status = "okay";
	};
	sim_flash_controller {
		compatible = "zephyr,sim-flash";
		#address-cells = <1>;
		#size-cells = <1>;
		erase-value = <0xff>;
		flash_sim0: flash_sim@0 {
			compatible = "soc-nv-flash";
			reg = <0x0 0x10000>;
			erase-block-size = <4096>;
			write-block-size = <4>;
			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;
				apps_partition: partition@0 {
					label = "applications";
					reg = <0x0 0x10000>;
				};
			};
		};
	};
};
