# Include from an exported Brickphyr SDK after defining executable ELF targets.
include_guard(GLOBAL)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(_BRICKPHYR_PACKAGE_SDK_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(brickphyr_package NAME)
  cmake_parse_arguments(PKG "" "ENTRY" "COMPONENTS;RESOURCES" ${ARGN})
  if(PKG_UNPARSED_ARGUMENTS OR PKG_KEYWORDS_MISSING_VALUES OR NOT PKG_ENTRY)
    message(FATAL_ERROR "brickphyr_package(NAME ENTRY target COMPONENTS targets... [RESOURCES name=path...])")
  endif()
  if(TARGET ${NAME})
    message(FATAL_ERROR "Package target already exists: ${NAME}")
  endif()
  if(NOT TARGET ${PKG_ENTRY})
    message(FATAL_ERROR "Package entry is not a target: ${PKG_ENTRY}")
  endif()
  get_target_property(entry_type ${PKG_ENTRY} TYPE)
  if(NOT entry_type STREQUAL "EXECUTABLE")
    message(FATAL_ERROR "Package entry must be an executable ELF target: ${PKG_ENTRY}")
  endif()

  set(sdk "${_BRICKPHYR_PACKAGE_SDK_DIR}")
  if(NOT LLEXT_EDK_INSTALL_DIR)
    message(FATAL_ERROR "Set LLEXT_EDK_INSTALL_DIR to the SDK used by brickphyr_package")
  endif()
  file(REAL_PATH "${sdk}" sdk_real)
  file(REAL_PATH "${LLEXT_EDK_INSTALL_DIR}" compiler_sdk_real)
  if(NOT sdk_real STREQUAL compiler_sdk_real)
    message(FATAL_ERROR "Package and native ELF targets must use the same Brickphyr SDK")
  endif()
  set(script "${sdk}/tools/package.py")
  set(output "${CMAKE_CURRENT_BINARY_DIR}/${NAME}.cbor")
  set(arguments --entry "$<TARGET_FILE:${PKG_ENTRY}>")
  set(dependencies ${PKG_ENTRY} "$<TARGET_FILE:${PKG_ENTRY}>")
  foreach(component IN LISTS PKG_COMPONENTS)
    if(NOT TARGET ${component})
      message(FATAL_ERROR "Package component is not a target: ${component}")
    endif()
    get_target_property(component_type ${component} TYPE)
    if(NOT component_type STREQUAL "EXECUTABLE")
      message(FATAL_ERROR "Package component must be an executable ELF target: ${component}")
    endif()
    list(APPEND arguments --component "$<TARGET_FILE:${component}>")
    list(APPEND dependencies ${component} "$<TARGET_FILE:${component}>")
  endforeach()
  foreach(resource IN LISTS PKG_RESOURCES)
    string(FIND "${resource}" "=" separator)
    if(separator LESS 1)
      message(FATAL_ERROR "Package resource must be name=path: ${resource}")
    endif()
    math(EXPR path_start "${separator} + 1")
    string(SUBSTRING "${resource}" ${path_start} -1 path)
    if(NOT IS_ABSOLUTE "${path}")
      get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    endif()
    string(SUBSTRING "${resource}" 0 ${separator} name)
    list(APPEND arguments --resource "${name}=${path}")
    list(APPEND dependencies "${path}")
  endforeach()

  add_custom_command(OUTPUT "${output}"
    COMMAND "${Python3_EXECUTABLE}" "${script}" ${arguments} --sdk "${sdk}" "${output}"
    DEPENDS ${dependencies} "${script}" "${sdk}/build.json"
      "${sdk}/include/brickphyr_abi.h"
    VERBATIM)
  add_custom_target(${NAME} DEPENDS "${output}")
endfunction()
