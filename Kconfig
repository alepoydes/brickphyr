mainmenu "Brickphyr"

source "Kconfig.zephyr"

config BRICKPHYR_NATIVE
	bool "Experimental protected native applications"
	depends on CPU_CORTEX_M && USERSPACE && ARM_MPU && LLEXT
	depends on LLEXT_HEAP_DYNAMIC && LLEXT_IMPORT_ALL_GLOBALS
	depends on !CURRENT_THREAD_USE_TLS && !USERSPACE_THREAD_MAY_RAISE_PRIORITY
	depends on LOG && LOG_MODE_DEFERRED
	select LOG_OUTPUT
	help
	  One separately built application, with a matching experimental SDK.

config BRICKPHYR_NATIVE_FIXTURES
	bool "Embed native lifecycle test images"
	depends on BRICKPHYR_NATIVE
	help
	  Board acceptance fixture; not an application upload mechanism.
