mainmenu "Brickphyr"

# Firmware services use queues/events; the native API exposes no mailboxes.
# Do not reserve descriptors for an unused asynchronous mailbox subsystem.
config NUM_MBOX_ASYNC_MSGS
	default 0

# Crypto temporaries share the system heap instead of a user-mapped libc arena.
config TF_PSA_CRYPTO_USER_CONFIG_FILE
	default "brickphyr/crypto_config.h" if BOARD_SPIKE_PRIME_F4 && MBEDTLS_BUILTIN && !MBEDTLS_ENABLE_HEAP

config HEAP_MEM_POOL_ADD_SIZE_BRICKPHYR_CRYPTO
	int
	default 2048 if MBEDTLS && TF_PSA_CRYPTO_USER_CONFIG_FILE = "brickphyr/crypto_config.h"
	default 0

# BC1.2 measures D+/D- before the USB PHY attaches to the host.
config CDC_ACM_SERIAL_ENABLE_AT_BOOT
	default n if BRICKPHYR_USB_BC12

# Full source discovery with six controller observations exceeds the upstream
# 384-byte default (about 430 bytes including the SMP header on F4).
config MCUMGR_TRANSPORT_NETBUF_SIZE
	default 512 if BRICKPHYR_MOTOR_CONTROL && BRICKPHYR_TELEMETRY

config MCUMGR_TRANSPORT_NETBUF_USER_DATA_SIZE
	default 16 if BRICKPHYR_CC2640_SMP && 64BIT
	default 8 if BRICKPHYR_CC2640_SMP

# Unknown SMP fields must not bypass the decoder's bounded nesting and exhaust
# its 2 KiB worker stack. Current management fields need no deeper skipped value.
config ZCBOR_MAX_RECURSION_DEPTH
	default 4 if MCUMGR

# Management commands have no acquisition deadline. Keep CBOR/file processing
# below the 833 Hz IMU and 200 Hz motor service, but above Shell/applications.
config MCUMGR_TRANSPORT_WORKQUEUE_THREAD_PRIO
	default 10 if BRICKPHYR_IMU || BRICKPHYR_MOTOR_CONTROL

# Bluetooth needs the cooperative system queue; USB core and CDC processing
# must be preemptible by the 1.2 ms acquisition and 5 ms control work.
config USBD_THREAD_PREEMPTIBLE
	default y if BOARD_SPIKE_PRIME_F4

config USBD_CDC_ACM_WORKQUEUE
	default y if BOARD_SPIKE_PRIME_F4

config USBD_CDC_ACM_WORKQUEUE_PRIORITY
	default 8 if BOARD_SPIKE_PRIME_F4

# Python admission uses about 1 KiB in the GATT callback; the pinned F4 build's
# HCI/L2CAP/ATT call chain adds 696 bytes. Leave room for exception/error paths.
config BT_RX_STACK_SIZE
	default 2048 if BRICKPHYR_PYTHON

config TASK_WDT_MIN_TIMEOUT
	default 1000 if BRICKPHYR_WATCHDOG

config TASK_WDT_HW_FALLBACK_DELAY
	default 1000 if BRICKPHYR_WATCHDOG

config TASK_WDT_CHANNELS
	default 2 if BRICKPHYR_WATCHDOG

source "Kconfig.zephyr"

config BRICKPHYR_HUB
	bool
	default y if BOARD_SPIKE_PRIME_F4 || BOARD_TECHNIC_HUB

config BRICKPHYR_CC2640_NPI
	bool "CC2640 SPI network-processor transport"
	depends on DT_HAS_TI_CC2640_NPI_ENABLED
	select GPIO
	select SPI
	select SPI_STM32_INTERRUPT if SOC_FAMILY_STM32
	help
	  Bounded SPI transport for the factory TI BLE stack on Technic Hub.
	  This does not enable advertising or a Bluetooth host endpoint.

config BRICKPHYR_CC2640_CONTROL
	bool "CC2640 controller and peripheral initialization"
	depends on BRICKPHYR_CC2640_NPI
	help
	  Use the TI protocol definitions and Pybricks startup sequence through NPI.
	  Includes peripheral GAP/GATT preparation and ATT handling. Enable
	  BRICKPHYR_CC2640_BLE to start the management endpoint at boot.

config BRICKPHYR_CC2640_BLE
	bool "CC2640 BLE management endpoint"
	depends on BRICKPHYR_CC2640_CONTROL && !BT
	depends on SHELL && MCUMGR_TRANSPORT_SHELL && SETTINGS_RUNTIME
	help
	  Run the factory TI peripheral stack on a dedicated worker and expose
	  the shared Pybricks identity and native Shell/SMP stream. This profile
	  has synthetic transport checks; physical Technic acceptance is pending.

config BRICKPHYR_CC2640_SMP
	bool "CC2640 SMP GATT transport"
	depends on MCUMGR && !BT
	depends on BRICKPHYR_CC2640_BLE || ZTEST
	default y if BRICKPHYR_CC2640_BLE
	select MCUMGR_TRANSPORT_REASSEMBLY
	help
	  Expose the standard MCUmgr BLE service through the factory TI stack.
	  Reuse Zephyr packet reassembly and command processing with the shared
	  management owner. This is independent of SMP over the Shell stream.

config BRICKPHYR_WATCHDOG
	bool "System progress watchdog"
	default y if BRICKPHYR_HUB
	depends on DT_HAS_ST_STM32_WATCHDOG_ENABLED || ARCH_POSIX
	select WATCHDOG
	select TASK_WDT
	select TASK_WDT_HW_FALLBACK
	select HWINFO
	help
	  Supervise initialization, the hub loop and system workqueue using
	  Zephyr Task Watchdog and an independent hardware fallback. The USB
	  powered off state continues supervision until a fresh button press.

config BRICKPHYR_WATCHDOG_TIMEOUT_MS
	int "Maximum interval without system progress (ms)"
	depends on BRICKPHYR_WATCHDOG
	default 3000
	range 100 10000

config BRICKPHYR_WATCHDOG_BOOT_TIMEOUT_MS
	int "Maximum initialization time after watchdog start (ms)"
	depends on BRICKPHYR_WATCHDOG
	default 10000
	range 100 30000

config BRICKPHYR_WATCHDOG_FIXTURE
	bool "Enable one-shot watchdog acceptance commands"
	depends on BRICKPHYR_WATCHDOG && SHELL
	help
	  Diagnostic image only. watchdog_test service stalls the system queue;
	  watchdog_test hardware also locks interrupts until the MCU resets.

config BRICKPHYR_PORTS
	bool "Powered Up port detection"
	default y if BOARD_SPIKE_PRIME_F4
	depends on DT_HAS_LEGO_POWERED_UP_PORTS_ENABLED
	select GPIO
	help
	  Detect empty, passive and UART ports using the Pybricks pin sequence
	  over Zephyr GPIO. The port service also owns sensor supply and coast.

config BRICKPHYR_PORT_UART
	bool "Powered Up UART messaging"
	default y if BOARD_SPIKE_PRIME_F4
	depends on BRICKPHYR_PORTS
	select SERIAL
	select UART_INTERRUPT_DRIVEN
	select UART_USE_RUNTIME_CONFIGURE
	select RING_BUFFER
	select SETTINGS
	select SETTINGS_RUNTIME
	select PINCTRL_NON_STATIC if PINCTRL
	select KERNEL_MEM_POOL
	help
	  Negotiate LUMP devices and acquire raw and converted sensor samples.
	  One worker owns GPIO, UART, measurement selection and recognized sensor
	  DC supply. Raw H-bridge access is not exposed.

config HEAP_MEM_POOL_ADD_SIZE_BRICKPHYR_PORT_UART
	int
	default 32768 if BRICKPHYR_PORT_UART
	help
	  Mode descriptions use the shared heap only while a UART device is
	  connected. Budget six ports with sixteen modes and all optional wire
	  payloads, including allocation and negotiation-growth overhead. Ordinary
	  devices allocate only their advertised payloads. No allocation occurs
	  on the DATA path.

config BRICKPHYR_MOTORS
	bool "Powered Up direct motor drive"
	default y if BOARD_SPIKE_PRIME_F4
	depends on BRICKPHYR_PORTS
	select PWM
	help
	  Owned, asynchronous native/Shell duty, brake and coast commands through
	  the port service. Outputs stay in coast at boot; application cleanup and
	  device loss stop them.

config BRICKPHYR_MOTOR_CONTROL
	bool "Powered Up speed and position control"
	default y if BOARD_SPIKE_PRIME_F4
	depends on BRICKPHYR_MOTORS && BRICKPHYR_PORT_UART && BRICKPHYR_BATTERY
	help
	  Reuse PBIO models, observer and trajectories in the existing port owner.
	  A dedicated port queue services the 5 ms model step independently of
	  system work. Missing encoder/battery input or a missed frame coasts the
	  motor and reports an error. Physical timing and tuning are experimental.

config BRICKPHYR_BATTERY
	bool "Battery voltage, load-current and temperature observations"
	default y if BOARD_SPIKE_PRIME_F4
	depends on DT_HAS_LEGO_ADC_BATTERY_ENABLED
	select ADC
	select REQUIRES_FULL_LIBC
	help
	  Shared native/Shell/SMP snapshots from Zephyr ADC, using the board's
	  Pybricks scaling. No charging control or state-of-charge estimate.

config BRICKPHYR_CHARGER
	bool "Prime hub battery charger"
	default y if BOARD_SPIKE_PRIME_F4
	depends on DT_HAS_LEGO_PRIME_CHARGER_ENABLED
	select ADC
	select PWM
	help
	  MP2639A charging and observations using the shared TLC5955 frame and
	  Pybricks current presets. Standard USB charging requires configuration;
	  dedicated charger detection is a separate USB BC1.2 capability.

config BRICKPHYR_USB_BC12
	bool "USB charger source detection"
	default y if BOARD_SPIKE_PRIME_F4
	depends on BRICKPHYR_CHARGER && USB_BC12
	depends on CDC_ACM_SERIAL_INITIALIZE_AT_BOOT
	help
	  Detect the source before attaching the existing CDC device. The hub
	  power loop handles cable changes, including USB-powered shutdown.

config BRICKPHYR_SOUND
	bool "Hub tone and PCM service"
	default y if BOARD_SPIKE_PRIME_F4
	help
	  One speaker owner, firmware-owned DMA samples and bounded PCM queue.
	  Native applications and the USB/BLE Shell use the same service.

config BRICKPHYR_SOUND_STM32
	bool "Prime F4 DAC sound output"
	default y if BOARD_SPIKE_PRIME_F4
	depends on BRICKPHYR_SOUND
	depends on DT_HAS_LEGO_PRIME_F4_SPEAKER_ENABLED && SOC_SERIES_STM32F4X
	depends on TIMER_HAS_64BIT_CYCLE_COUNTER
	select DMA
	select GPIO
	select PINCTRL
	select RESET
	help
	  Timer-triggered DAC samples through Zephyr DMA. The driver owns DAC1
	  channel 1, TIM6 and the speaker amplifier; no sound starts at boot.

config BRICKPHYR_IMU
	bool "Hub IMU acquisition and orientation"
	default y if BOARD_SPIKE_PRIME_F4
	depends on DT_HAS_ST_LSM6DS3TR_C_ENABLED && TIMER_HAS_64BIT_CYCLE_COUNTER
	select I2C
	select GPIO
	help
	  One bounded worker uses the ST/Pybricks register API and ported
	  calibration/orientation algorithms. Native applications and telemetry
	  share read-only snapshots; calibration uses Zephyr Settings.

config BRICKPHYR_TELEMETRY
	bool "Read-only hub observations"
	default y if BOARD_SPIKE_PRIME_F4
	depends on MCUMGR && SHELL
	select MCUMGR_SMP_CBOR_MIN_DECODING_LEVEL_2
	select MCUMGR_SMP_CBOR_MIN_ENCODING_LEVEL_2 if ZCBOR_CANONICAL
	select MCUMGR_SMP_CBOR_MIN_ENCODING_LEVEL_1
	select CBPRINTF_FP_SUPPORT if BRICKPHYR_PORT_UART
	help
	  On-demand snapshots through SMP and the shared shell. No background
	  transmission, sensor reconfiguration or application lifecycle work.

config BRICKPHYR_MATRIX
	bool "Hub light matrix"
	default y
	depends on DT_HAS_LEGO_HUB_MATRIX_ENABLED && LED
	help
	  Shared 5 by 5 display, with application and terminal ownership.

config BRICKPHYR_LIGHT
	bool "Application access to hub button lighting"
	default y
	depends on (DT_HAS_TI_TLC5955_ENABLED && LED) || (DT_HAS_LEGO_HUB_PWM_RGB_ENABLED && PWM)
	help
	  Shared system indication and application colors on the hub buttons.
	  The base readiness indication remains available without this API.

config BRICKPHYR_NATIVE
	bool "Experimental protected native applications"
	depends on CPU_CORTEX_M && USERSPACE && ARM_MPU && LLEXT
	depends on LLEXT_HEAP_DYNAMIC && LLEXT_IMPORT_ALL_GLOBALS
	depends on !CURRENT_THREAD_USE_TLS && !USERSPACE_THREAD_MAY_RAISE_PRIORITY
	depends on LOG && LOG_MODE_DEFERRED
	select LOG_OUTPUT
	help
	  One separately built application, with a compatible versioned SDK.

config BRICKPHYR_NATIVE_FIXTURES
	bool "Embed native lifecycle test images"
	depends on BRICKPHYR_NATIVE
	help
	  Board acceptance fixture; not an application upload mechanism.

config LLEXT_EXPORT_SYMBOL_GROUP_BRICKPHYR
	bool
	default y if BRICKPHYR_NATIVE

config BRICKPHYR_APPLICATION_STACK_SIZE
	int "Application stack bytes"
	depends on BRICKPHYR_NATIVE
	default 12288 if BRICKPHYR_PYTHON
	default 2048
	range 2048 32768
	help
	  Shared by execution engines. Python compilation and exception reporting
	  require more stack than the minimal native entry; measure high-water use.

config BRICKPHYR_APPLICATION_IMAGE_SIZE
	int "Maximum uploaded application bytes"
	default 32768
	range 1024 65536
	help
	  Admission limit, not a reservation. A RAM upload also needs this much
	  free system heap while the execution arena holds the loaded program.

config BRICKPHYR_APPLICATION_MEMORY_SIZE
	int "Application execution arena bytes"
	default 65536
	range 8192 262144
	help
	  Shared native loader/Python heap arena. Native allocations have separate
	  MPU regions; Python maps the whole arena and requires a power-of-two size.

config BRICKPHYR_PYTHON
	bool "Experimental MicroPython engine"
	depends on BRICKPHYR_NATIVE || (TEST && (ARCH_POSIX || (CPU_CORTEX_M && USERSPACE)))
	depends on ZCBOR
	help
	  MicroPython core with source compilation, bytecode loading and GC.
	  Host integration and Pybricks bindings are under development.

config BRICKPHYR_PYBRICKS
	bool "Experimental Pybricks Python library"
	depends on BRICKPHYR_PYTHON
	default y
	help
	  Reuse the reference Python bindings over the shared runtime and
	  device services. Current coverage is listed in docs/compatibility.md.

config BRICKPHYR_PYBRICKS_EXECUTION
	bool "Pybricks client execution adapter"
	depends on BRICKPHYR_PYTHON && BRICKPHYR_NATIVE
	default y if BRICKPHYR_PYBRICKS
	help
	  Upload, run, interrupt and exchange application data through the
	  Pybricks USB/BLE protocol. Native SMP, Shell and REPL do not require
	  this adapter. Without it the protocol reports no execution capabilities.

config BRICKPHYR_APP_STORAGE
	bool "Installed native applications in LittleFS"
	depends on BRICKPHYR_NATIVE && FILE_SYSTEM_LITTLEFS && FLASH_MAP
	depends on DT_HAS_FIXED_PARTITIONS_ENABLED
	depends on FILE_SYSTEM_MKFS
	depends on !MCUMGR || MCUMGR_GRP_FS_FILE_ACCESS_HOOK

config BRICKPHYR_RADIO
	bool "Application BLE observations"
	depends on BRICKPHYR_NATIVE && BT && BT_PERIPHERAL && BT_OBSERVER
	default y
	help
	  Observe Pybricks broadcasts through the same Zephyr radio as management.
	  Only requested channels allocate storage; applications get copied samples.

config BRICKPHYR_BLE_PEER
	bool "Application BLE peripherals"
	depends on BRICKPHYR_RADIO && BT_CENTRAL && BT_GATT_CLIENT && BT_MAX_CONN >= 2
	default y
	help
	  One LEGO Wireless Protocol v3 or Xbox HID peer alongside management.
	  Discovery and ATT use the existing radio workqueue. Pairing additionally
	  requires BT_SMP; notification buffers are allocated per application lease.

config BRICKPHYR_HUB_NETWORK
	bool "Application Classic hub network"
	depends on BRICKPHYR_RADIO && BT_CLASSIC && BT_MAX_CONN >= 4
	default y
	help
	  Pybricks star networking over Classic L2CAP, alongside BLE management.
	  Kernel-owned per-source inboxes and relay queues are allocated on demand.

config BRICKPHYR_PYBRICKS_SLOTS
	int "Persistent Pybricks program slots"
	depends on BRICKPHYR_PYBRICKS_EXECUTION && BRICKPHYR_APP_STORAGE && SHELL
	range 0 128
	default 5 if BOARD_SPIKE_PRIME_F4
	default 0
	help
	  Map client slots to reserved names in the common application store.
	  They share its free space with named applications. Zero keeps the
	  RAM-only adapter. Native temporary uploads never write this store.
