mainmenu "Brickphyr"

# Full source discovery with six controller observations exceeds the upstream
# 384-byte default (about 430 bytes including the SMP header on F4).
config MCUMGR_TRANSPORT_NETBUF_SIZE
	default 512 if BRICKPHYR_MOTOR_CONTROL && BRICKPHYR_TELEMETRY

# Management commands have no acquisition deadline. Keep CBOR/file processing
# below the 833 Hz IMU and 200 Hz motor service, but above Shell/applications.
config MCUMGR_TRANSPORT_WORKQUEUE_THREAD_PRIO
	default 10 if BRICKPHYR_IMU || BRICKPHYR_MOTOR_CONTROL

# Bluetooth needs the cooperative system queue; CDC processing must instead
# be preemptible by the 1.2 ms acquisition and 5 ms control work.
config USBD_CDC_ACM_WORKQUEUE
	default y if BOARD_SPIKE_PRIME_F4

config USBD_CDC_ACM_WORKQUEUE_PRIORITY
	default 8 if BOARD_SPIKE_PRIME_F4

config TASK_WDT_MIN_TIMEOUT
	default 1000 if BRICKPHYR_WATCHDOG

config TASK_WDT_HW_FALLBACK_DELAY
	default 1000 if BRICKPHYR_WATCHDOG

config TASK_WDT_CHANNELS
	default 2 if BRICKPHYR_WATCHDOG

source "Kconfig.zephyr"

config BRICKPHYR_WATCHDOG
	bool "System progress watchdog"
	default y if BOARD_SPIKE_PRIME_F4
	depends on DT_HAS_ST_STM32_WATCHDOG_ENABLED || ARCH_POSIX
	select WATCHDOG
	select TASK_WDT
	select TASK_WDT_HW_FALLBACK
	select HWINFO
	help
	  Supervise initialization, the hub loop and system workqueue using
	  Zephyr Task Watchdog and an independent hardware fallback. The USB
	  powered off state continues supervision until a fresh button press.

config BRICKPHYR_WATCHDOG_TIMEOUT_MS
	int "Maximum interval without system progress (ms)"
	depends on BRICKPHYR_WATCHDOG
	default 3000
	range 100 10000

config BRICKPHYR_WATCHDOG_BOOT_TIMEOUT_MS
	int "Maximum initialization time after watchdog start (ms)"
	depends on BRICKPHYR_WATCHDOG
	default 10000
	range 100 30000

config BRICKPHYR_WATCHDOG_FIXTURE
	bool "Enable one-shot watchdog acceptance commands"
	depends on BRICKPHYR_WATCHDOG && SHELL
	help
	  Diagnostic image only. watchdog_test service stalls the system queue;
	  watchdog_test hardware also locks interrupts until the MCU resets.

config BRICKPHYR_PORTS
	bool "Powered Up port detection"
	default y if BOARD_SPIKE_PRIME_F4
	depends on DT_HAS_LEGO_POWERED_UP_PORTS_ENABLED
	select GPIO
	help
	  Detect empty, passive and UART ports using the Pybricks pin sequence
	  over Zephyr GPIO. The port service also owns sensor supply and coast.

config BRICKPHYR_PORT_UART
	bool "Powered Up UART messaging"
	default y if BOARD_SPIKE_PRIME_F4
	depends on BRICKPHYR_PORTS
	select SERIAL
	select UART_INTERRUPT_DRIVEN
	select UART_USE_RUNTIME_CONFIGURE
	select RING_BUFFER
	select PINCTRL_NON_STATIC if PINCTRL
	help
	  Negotiate LUMP devices and acquire raw and converted sensor samples.
	  One worker owns GPIO, UART, measurement selection and recognized sensor
	  DC supply. Raw H-bridge access is not exposed.

config BRICKPHYR_MOTORS
	bool "Powered Up direct motor drive"
	default y if BOARD_SPIKE_PRIME_F4
	depends on BRICKPHYR_PORTS
	select PWM
	help
	  Owned, asynchronous native/Shell duty, brake and coast commands through
	  the port service. Outputs stay in coast at boot; application cleanup and
	  device loss stop them.

config BRICKPHYR_MOTOR_CONTROL
	bool "Powered Up speed and position control"
	default y if BOARD_SPIKE_PRIME_F4
	depends on BRICKPHYR_MOTORS && BRICKPHYR_PORT_UART && BRICKPHYR_BATTERY
	help
	  Reuse PBIO models, observer and trajectories in the existing port owner.
	  A dedicated port queue services the 5 ms model step independently of
	  system work. Missing encoder/battery input or a missed frame coasts the
	  motor and reports an error. Physical timing and tuning are experimental.

config BRICKPHYR_BATTERY
	bool "Battery voltage and load-current observations"
	default y if BOARD_SPIKE_PRIME_F4
	depends on DT_HAS_LEGO_ADC_BATTERY_ENABLED
	select ADC
	help
	  Shared native/Shell/SMP snapshots from Zephyr ADC, using the board's
	  Pybricks scaling. No charging control or state-of-charge estimate.

config BRICKPHYR_SOUND
	bool "Hub tone and PCM service"
	default y if BOARD_SPIKE_PRIME_F4
	help
	  One speaker owner, firmware-owned DMA samples and bounded PCM queue.
	  Native applications and the USB/BLE Shell use the same service.

config BRICKPHYR_SOUND_STM32
	bool "Prime F4 DAC sound output"
	default y if BOARD_SPIKE_PRIME_F4
	depends on BRICKPHYR_SOUND
	depends on DT_HAS_LEGO_PRIME_F4_SPEAKER_ENABLED && SOC_SERIES_STM32F4X
	depends on TIMER_HAS_64BIT_CYCLE_COUNTER
	select DMA
	select GPIO
	select PINCTRL
	select RESET
	help
	  Timer-triggered DAC samples through Zephyr DMA. The driver owns DAC1
	  channel 1, TIM6 and the speaker amplifier; no sound starts at boot.

config BRICKPHYR_IMU
	bool "Hub IMU acquisition and orientation"
	default y if BOARD_SPIKE_PRIME_F4
	depends on DT_HAS_ST_LSM6DS3TR_C_ENABLED && TIMER_HAS_64BIT_CYCLE_COUNTER
	select I2C
	select GPIO
	help
	  One bounded worker uses the ST/Pybricks register API and ported
	  calibration/orientation algorithms. Native applications and telemetry
	  share read-only snapshots; calibration uses Zephyr Settings.

config BRICKPHYR_TELEMETRY
	bool "Read-only hub observations"
	default y if BOARD_SPIKE_PRIME_F4
	depends on MCUMGR && SHELL
	select MCUMGR_SMP_CBOR_MIN_DECODING_LEVEL_2
	select MCUMGR_SMP_CBOR_MIN_ENCODING_LEVEL_2 if ZCBOR_CANONICAL
	select MCUMGR_SMP_CBOR_MIN_ENCODING_LEVEL_1
	select CBPRINTF_FP_SUPPORT if BRICKPHYR_PORT_UART
	help
	  On-demand snapshots through SMP and the shared shell. No background
	  transmission, sensor reconfiguration or application lifecycle work.

config BRICKPHYR_MATRIX
	bool "Hub light matrix"
	default y
	depends on DT_HAS_LEGO_HUB_MATRIX_ENABLED && LED
	help
	  Shared 5 by 5 display, with application and terminal ownership.

config BRICKPHYR_NATIVE
	bool "Experimental protected native applications"
	depends on CPU_CORTEX_M && USERSPACE && ARM_MPU && LLEXT
	depends on LLEXT_HEAP_DYNAMIC && LLEXT_IMPORT_ALL_GLOBALS
	depends on !CURRENT_THREAD_USE_TLS && !USERSPACE_THREAD_MAY_RAISE_PRIORITY
	depends on LOG && LOG_MODE_DEFERRED
	select LOG_OUTPUT
	help
	  One separately built application, with a matching experimental SDK.

config BRICKPHYR_NATIVE_FIXTURES
	bool "Embed native lifecycle test images"
	depends on BRICKPHYR_NATIVE
	help
	  Board acceptance fixture; not an application upload mechanism.

config BRICKPHYR_APP_STORAGE
	bool "Installed native applications in LittleFS"
	depends on BRICKPHYR_NATIVE && FILE_SYSTEM_LITTLEFS && FLASH_MAP
	depends on DT_HAS_FIXED_PARTITIONS_ENABLED
	depends on FILE_SYSTEM_MKFS
	depends on !MCUMGR || MCUMGR_GRP_FS_FILE_ACCESS_HOOK
