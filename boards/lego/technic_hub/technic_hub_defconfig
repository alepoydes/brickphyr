CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_USERSPACE=y
# The main thread owns hub supervision and never enters an application domain.
CONFIG_MAIN_THREAD_USERSPACE=n
# Hardware access belongs to privileged services; applications use the versioned API table.
CONFIG_UART_USERSPACE=n
CONFIG_GPIO_USERSPACE=n
CONFIG_SPI_USERSPACE=n
CONFIG_I2C_USERSPACE=n
CONFIG_ADC_USERSPACE=n
CONFIG_PWM_USERSPACE=n
CONFIG_WDT_USERSPACE=n
CONFIG_HWINFO_USERSPACE=n
CONFIG_FPU=y
CONFIG_FP_HARDABI=y
CONFIG_GPIO=y
CONFIG_GPIO_HOGS=y
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_INPUT=y
CONFIG_INPUT_MODE_SYNCHRONOUS=y
CONFIG_PWM=y
CONFIG_LOG=y
CONFIG_LOG_DEFAULT_LEVEL=2
