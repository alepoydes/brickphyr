/dts-v1/;
#include <st/f4/stm32f413Xg.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <st/f4/stm32f413v(g-h)tx-pinctrl.dtsi>

/ {
	model = "LEGO SPIKE Prime F4";
	compatible = "lego,spike-prime-f4";
	aliases {
		watchdog0 = &iwdg;
	};
	zephyr,user {
		vbus-gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &firmware_partition;
		zephyr,console = &cdc_acm_uart;
		zephyr,shell-uart = &cdc_acm_uart;
		zephyr,settings-partition = &settings_partition;
		zephyr,bt-hci = &bt_hci;
	};

	bt_slow_clock: bt-slow-clock {
		compatible = "pwm-clock";
		#clock-cells = <1>;
		/* 96 MHz / 2930 = 32764.5 Hz, matching the Pybricks F4 setup. */
		pwms = <&bt_pwm 4 30521 PWM_POLARITY_NORMAL>;
		status = "disabled";
	};
};

&usart2 {
	current-speed = <115200>;
	hw-flow-control;
	pinctrl-0 = <&usart2_cts_pd3 &usart2_rts_pd4 &usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	bt_hci: bt-hci {
		compatible = "zephyr,bt-hci-uart";
		reset-gpios = <&gpioa 2 GPIO_ACTIVE_LOW>;
		reset-assert-duration-ms = <5>;
		status = "disabled";
	};
};

&usart2_cts_pd3 {
	/delete-property/ bias-pull-up;
	bias-disable;
};

&usart2_rx_pd6 { bias-pull-up; };

&timers8 {
	bt_pwm: pwm {
		pinctrl-0 = <&tim8_ch4_pc9>;
		pinctrl-names = "default";
		status = "disabled";
	};
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pc2 &spi2_mosi_pc3>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;

	external_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <12000000>;
		/* SFDP selects 4-byte address mode, as used by the LEGO loader. */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			/* Remaining part of the same Pybricks user-storage reservation.
			 * No application filesystem may format foreign contents. */
			apps_partition: partition@80000 {
				label = "applications";
				reg = <0x80000 0x38000>;
			};
			/* Tail of Pybricks' 512..768 KiB user-storage region. */
			settings_partition: partition@b8000 {
				label = "settings";
				reg = <0xb8000 0x8000>;
			};
		};
	};
};

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb3>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	scl-gpios = <&gpiob 10 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_HIGH)>;
	sda-gpios = <&gpiob 3 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_HIGH)>;

	hub_imu: imu@6a {
		compatible = "st,lsm6ds3tr-c";
		reg = <0x6a>;
		irq-gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>;
		/* Pinned Pybricks Prime F4 mounting orientation. */
		axis-signs = <(-1) 1 (-1)>;
	};
};

&i2c2_scl_pb10 {
	/delete-property/ bias-pull-up;
	bias-disable;
	slew-rate = "very-high-speed";
};

&i2c2_sda_pb3 {
	/delete-property/ bias-pull-up;
	bias-disable;
	slew-rate = "very-high-speed";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

&iwdg { status = "okay"; };

&pll {
	div-m = <8>;
	mul-n = <96>;
	div-p = <2>;
	div-q = <4>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(96)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&gpioa {
	power_hold: power-hold {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

/* Both H-bridge inputs low is coast in the reference Pybricks driver. */
&gpiob {
	motors-off {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>, <6 GPIO_ACTIVE_HIGH>,
			<7 GPIO_ACTIVE_HIGH>, <8 GPIO_ACTIVE_HIGH>, <9 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpioc {
	motors-off {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>, <7 GPIO_ACTIVE_HIGH>, <8 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpioe {
	motors-off {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>, <11 GPIO_ACTIVE_HIGH>,
			<13 GPIO_ACTIVE_HIGH>, <14 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";

	cdc_acm_uart: cdc-acm-uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		factory_boot_partition: partition@0 {
			label = "factory-dfu";
			reg = <0 DT_SIZE_K(32)>;
			read-only;
		};

		mboot_partition: partition@8000 {
			label = "mboot";
			reg = <0x8000 DT_SIZE_K(32)>;
			read-only;
		};

		firmware_partition: partition@10000 {
			label = "firmware";
			reg = <0x10000 DT_SIZE_K(960)>;
		};
	};
};

#include "buttons.dtsi"
#include "battery.dtsi"
#include "ports.dtsi"

&adc1 {
	pinctrl-0 = <&adc1_in1_pa1 &adc1_in14_pc4 &adc1_in10_pc0 &adc1_in11_pc1>;
	pinctrl-names = "default";
	st,adc-prescaler = <4>;
	status = "okay";
};

&timers12 {
	status = "okay";
	gsclk: pwm {
		pinctrl-0 = <&tim12_ch2_pb15>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	status = "okay";

	hub_leds: leds@0 {
		compatible = "ti,tlc5955";
		reg = <0>;
		spi-max-frequency = <24000000>;
		latch-gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>;
		pwms = <&gsclk 2 104 PWM_POLARITY_NORMAL>;
		/* MODE: full duty disables charging until a charger driver owns it. */
		initial-full-channels = <14>;
	};
};

#include "lights.dtsi"
#include "sound.dtsi"

/* Keep the reboot request above the RAM used by the existing bootloaders. */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(319)>;
};

/ {
	boot_request: memory@2004fc00 {
		compatible = "zephyr,memory-region";
		reg = <0x2004fc00 DT_SIZE_K(1)>;
		zephyr,memory-region = "BOOT_REQUEST";
	};
};
