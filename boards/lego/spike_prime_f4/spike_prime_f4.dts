/dts-v1/;
#include <st/f4/stm32f413Xg.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <st/f4/stm32f413v(g-h)tx-pinctrl.dtsi>

/ {
	model = "LEGO SPIKE Prime F4";
	compatible = "lego,spike-prime-f4";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &firmware_partition;
		zephyr,console = &cdc_acm_uart;
		zephyr,shell-uart = &cdc_acm_uart;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

&pll {
	div-m = <8>;
	mul-n = <96>;
	div-p = <2>;
	div-q = <4>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(96)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&gpioa {
	power_hold: power-hold {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

/* Both H-bridge inputs low is coast in the reference Pybricks driver. */
&gpiob {
	motors-off {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>, <6 GPIO_ACTIVE_HIGH>,
			<7 GPIO_ACTIVE_HIGH>, <8 GPIO_ACTIVE_HIGH>, <9 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpioc {
	motors-off {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>, <7 GPIO_ACTIVE_HIGH>, <8 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpioe {
	motors-off {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>, <11 GPIO_ACTIVE_HIGH>,
			<13 GPIO_ACTIVE_HIGH>, <14 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";

	cdc_acm_uart: cdc-acm-uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		factory_boot_partition: partition@0 {
			label = "factory-dfu";
			reg = <0 DT_SIZE_K(32)>;
			read-only;
		};

		mboot_partition: partition@8000 {
			label = "mboot";
			reg = <0x8000 DT_SIZE_K(32)>;
			read-only;
		};

		firmware_partition: partition@10000 {
			label = "firmware";
			reg = <0x10000 DT_SIZE_K(960)>;
		};
	};
};

#include "buttons.dtsi"

&adc1 {
	pinctrl-0 = <&adc1_in1_pa1 &adc1_in14_pc4>;
	pinctrl-names = "default";
	st,adc-prescaler = <4>;
	status = "okay";
};

&timers12 {
	status = "okay";
	gsclk: pwm {
		pinctrl-0 = <&tim12_ch2_pb15>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	status = "okay";

	hub_leds: leds@0 {
		compatible = "ti,tlc5955";
		reg = <0>;
		spi-max-frequency = <24000000>;
		latch-gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>;
		pwms = <&gsclk 2 104 PWM_POLARITY_NORMAL>;
		/* MODE: full duty disables charging until a charger driver owns it. */
		initial-full-channels = <14>;
		status_top: status-top { channels = <5 4 3>; };
		status_bottom: status-bottom { channels = <8 7 6>; };
		bluetooth_led: bluetooth { channels = <20 19 18>; };
	};
};

/* Keep the reboot request above the RAM used by the existing bootloaders. */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(319)>;
};

/ {
	boot_request: memory@2004fc00 {
		compatible = "zephyr,memory-region";
		reg = <0x2004fc00 DT_SIZE_K(1)>;
		zephyr,memory-region = "BOOT_REQUEST";
	};
};
