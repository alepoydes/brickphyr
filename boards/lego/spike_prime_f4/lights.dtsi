&hub_leds {
	/* Provisional gains from visual RGB-pair checks on Inventor F4. */
	white-balance = <255 47 64>;
	status_top: status-top { channels = <5 4 3>; };
	status_bottom: status-bottom { channels = <8 7 6>; };
	bluetooth_led: bluetooth { channels = <20 19 18>; };
};
