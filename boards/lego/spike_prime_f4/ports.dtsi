	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart5_tx_pc12 &uart5_rx_pd2>;
	pinctrl-names = "default";
};

&uart5_tx_pc12 {
	/delete-property/ bias-pull-up;
	bias-disable;
};

&uart5_rx_pd2 {
	/delete-property/ bias-pull-up;
	bias-disable;
};

&uart10 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart10_tx_pe3 &uart10_rx_pe2>;
	pinctrl-names = "default";
