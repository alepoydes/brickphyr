CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_USERSPACE=y
CONFIG_GPIO=y
CONFIG_GPIO_HOGS=y
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_LINE_CTRL=y
CONFIG_USB_DEVICE_STACK_NEXT=y
CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT=y
CONFIG_CDC_ACM_SERIAL_MANUFACTURER_STRING="Brickphyr"
CONFIG_CDC_ACM_SERIAL_PRODUCT_STRING="Brickphyr bring-up console"
CONFIG_CDC_ACM_SERIAL_SELF_POWERED=y
CONFIG_CDC_ACM_SERIAL_MAX_POWER=250
CONFIG_ADC=y
# Single-channel 15+12 cycles at 24 MHz: 1.125 us. Allow 2 ms for IRQ
# delivery, then stop failed conversion before releasing the caller's buffer.
CONFIG_ADC_STM32_CONVERSION_TIMEOUT_MS=2
CONFIG_INPUT=y
CONFIG_INPUT_MODE_SYNCHRONOUS=y
CONFIG_SPI=y
CONFIG_SPI_STM32_INTERRUPT=y
CONFIG_SPI_STM32_DMA=y
CONFIG_PWM=y
CONFIG_LED=y
CONFIG_I2C_STM32_BUS_RECOVERY=y
# Normal 12-byte acquisition takes ~0.34 ms; bound a failed transfer to 10 ms.
CONFIG_I2C_STM32_TRANSFER_TIMEOUT_MSEC=10
CONFIG_LOG=y
CONFIG_LOG_DEFAULT_LEVEL=2
